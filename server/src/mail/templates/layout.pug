- const sans = "'TT Neoris',system-ui,-apple-system,'Segoe UI',Helvetica,Arial,sans-serif"
- const footerLinks = [["Home", "/"], ["People", "/people"], ["Guide", "/guide"], ["Progress", "/progress"], ["Partner", "/partner"]]

mixin button(url, label)
  table.button(role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0")
    tr
      td(align="center" bgcolor="#62a124" style="border-radius:6px;")
        a(href=url target="_blank" style=`display:block;text-align:center;padding:14px 16px;font-family:${sans};font-size:16px;font-weight:500;line-height:16px;color:#ffffff;text-decoration:none;border-radius:6px;-webkit-font-smoothing:antialiased;`)= label

doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(name="color-scheme" content="light")
    title
      block title
    style.
      @font-face { font-family: "TT Neoris"; font-weight: 400; src: url("#{siteUrl}/assets/fonts/redesign/TTNeoris-Regular.latin.woff2") format("woff2"); }
      @font-face { font-family: "TT Neoris"; font-weight: 500; src: url("#{siteUrl}/assets/fonts/redesign/TTNeoris-Medium.latin.woff2") format("woff2"); }
      @font-face { font-family: "Libre Caslon Text"; font-weight: 700; src: url("#{siteUrl}/assets/fonts/redesign/LibreCaslonText-Bold.woff2") format("woff2"); }
      .content p, .content h3, .content ul, .content ol { margin: 0 0 16px 0; }
      .content a { color: #1e68d9; }
      .content img { max-width: 100%; height: auto; }
      .content .button { margin: 16px 0 16px 0; }
      .content .fine-print, .content .fine-print a { font-size: 14px; color: #71717a; }
      @media (max-width: 480px) {
        .card-x { padding-left: 24px !important; padding-right: 24px !important; }
        .footer { padding-left: 12px !important; padding-right: 12px !important; }
        .site-link { padding: 0 6px !important; }
      }
  body(style="margin:0;padding:0;background-color:#f4f4f2;")
    table(role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f4f4f2;")
      tr
        td(align="center" style="padding:32px 16px;")
          table(role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;background-color:#ffffff;border-radius:8px;")
            tr
              td.content.card-x(style="padding:40px 40px 24px 40px;font-family:'Source Sans 3',-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;font-size:17px;line-height:1.55;color:#1f2933;")
                block content
            tr
              td.footer(align="center" style="padding:32px 24px;border-top:1px solid #e6e6e3;")
                a(href=siteUrl target="_blank" style="font-family:'Libre Caslon Text',Georgia,'Times New Roman',serif;font-size:20px;font-weight:700;letter-spacing:0.02em;line-height:1;color:#000000;text-decoration:none;white-space:nowrap;") The Alliance
                div(style="margin-top:16px;line-height:20px;")
                  each link in footerLinks
                    a.site-link(href=`${siteUrl}${link[1]}` target="_blank" style=`display:inline-block;padding:0 10px;font-family:${sans};font-size:14px;line-height:20px;color:#71717a;text-decoration:none;white-space:nowrap;`)= link[0]
                    = " "
