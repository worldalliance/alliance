doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Your Alliance waitlist link

  body
    p Here’s your personal link for inviting others to join the Alliance waitlist:
    p #{url}
    p If you didn’t ask for this email, you can ignore it.
    include waitlist-unsubscribe.pug
