doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title You’re on the Alliance waitlist

  body
    p You’re on the Alliance waitlist. We’ll email you when you can join.
    p Invite others to join with your personal link:
    p #{url}
    p If you didn’t join the waitlist, you can ignore this email.
    include waitlist-unsubscribe.pug
