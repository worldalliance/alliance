APP_URL=http://localhost:5173
# Invite links are built from this; falls back to APP_URL when unset.
ALT_APP_URL=
ADMIN_URL=http://localhost:5174
ALT_ADMIN_URL=

APNS_KEY_ID=xxx
APNS_TEAM_ID=xxx
APNS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nxxx\n-----END PRIVATE KEY-----
# Google sign-in: the Web application client under APIs & Services >
# Credentials in the Google Cloud console. The mobile app's native sign-in also
# names this client id as its server client, so its tokens verify here too.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple sign-in, from Certificates, Identifiers & Profiles in the developer
# portal. The Services ID is the web client; native tokens carry a bundle id,
# comma-separated here. The key is the .p8 file, base64 on one line.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_SERVICES_ID=
APPLE_BUNDLE_ID=
APPLE_PRIVATE_KEY_BASE64=
