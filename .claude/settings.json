{
  "permissions": {
    "allow": [
      "Bash(bun run build)",
      "Bash(bun run gen-api)",
      "Bash(bun run test:*)"
    ],
    "deny": ["Artifact", "Workflow"]
  },
  "autoMemoryEnabled": false,
  "disableArtifact": true,
  "skillOverrides": {
    "update-config": "off",
    "keybindings-help": "off",
    "code-review": "off",
    "simplify": "off",
    "fewer-permission-prompts": "off",
    "schedule": "off",
    "claude-api": "off",
    "workflow-authoring": "off",
    "run": "off",
    "init": "off",
    "security-review": "off",
    "dataviz": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/agents/chats/chats.ts check"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/trim-comments-reminder.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/agents/chats/chats.ts upload claude",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/agents/chats/chats.ts upload claude",
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/agents/chats/chats.ts upload claude",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/agents/chats/chats.ts upload claude",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
