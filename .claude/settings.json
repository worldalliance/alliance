{
  "permissions": {
    "allow": [
      "Bash(bun run build)",
      "Bash(bun run gen-api)",
      "Bash(bun run test:*)"
    ],
    "deny": ["Artifact", "Workflow"]
  },
  "autoMemoryEnabled": false,
  "disableArtifact": true,
  "skillOverrides": {
    "update-config": "off",
    "keybindings-help": "off",
    "code-review": "off",
    "simplify": "off",
    "fewer-permission-prompts": "off",
    "schedule": "off",
    "claude-api": "off",
    "workflow-authoring": "off",
    "run": "off",
    "init": "off",
    "security-review": "off",
    "dataviz": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$ALLIANCE_AGENT_CHATS\" = off ] || { command -v jq && aws configure get aws_access_key_id --profile alliance-agent-chats; } >/dev/null 2>&1 || echo '{\"systemMessage\": \"Agent transcript uploads are not set up on this machine: agents/README.md says how.\"}'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/trim-comments-reminder.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/agents/chats/sync.sh claude",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/agents/chats/sync.sh claude",
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/agents/chats/sync.sh claude",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/agents/chats/sync.sh claude",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
