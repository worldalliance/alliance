{
  "permissions": {
    "allow": [
      "Bash(bun run build)",
      "Bash(bun run gen-api)",
      "Bash(bun run test:*)"
    ],
    "deny": ["Artifact", "ScheduleWakeup", "Workflow"]
  },
  "autoMemoryEnabled": false,
  "disableArtifact": true,
  "disableBundledSkills": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/trim-comments-reminder.sh"
          }
        ]
      }
    ]
  }
}
