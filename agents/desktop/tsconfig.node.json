{
  "compilerOptions": {
    "strict": true,
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024"],
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "electron.vite.config.ts",
    "playwright.config.ts",
    "src/main",
    "src/preload",
    "src/shared",
    "e2e"
  ],
  "exclude": ["src/**/*.test.ts"]
}
