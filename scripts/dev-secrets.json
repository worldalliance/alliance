{
  "server": {
    "envFile": "server/.env",
    "loadsEnvFile": true,
    "secrets": [
      "ADMIN_PASSWORD",
      "ADMIN_USER",
      "APPLE_PRIVATE_KEY_BASE64",
      "EXPO_ACCESS_TOKEN",
      "GOOGLE_CLIENT_SECRET",
      "JWT_REFRESH_SECRET",
      "JWT_SECRET",
      "MAILGUN_SIGNING_KEY",
      "PANGRAM_API_KEY",
      "POSTHOG_QUERY_KEY",
      "SLACK_WEBHOOK_URL",
      "SMTP_PASSWORD",
      "SMTP_USER",
      "TWILIO_ACCOUNT_SID",
      "TWILIO_AUTH_TOKEN",
      "TWILIO_PHONE_NUMBER"
    ]
  },
  "devtools": {
    "envFile": ".env.devtools",
    "loadsEnvFile": false,
    "secrets": ["LINEAR_CLIENT_ID", "LINEAR_CLIENT_SECRET"]
  }
}
