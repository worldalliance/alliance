[Unit]
Description=Nightly prod to staging sync

[Timer]
# Change SYNC_SCHEDULED_AT in alliance-prod-to-staging-sync.service with it.
# The deploy that changes this starts the service at once if the new time has
# come since the last run. The script skips that run unless the deploy lands
# within 5 minutes of the new time on a day its run hasn't started yet.
OnCalendar=*-*-* 10:30:00 UTC
# A catch-up run after downtime could swap staging's database mid-workday.
Persistent=false

[Install]
WantedBy=timers.target
