[Unit]
Description=Nightly prod to staging sync

[Timer]
# A deploy that changes this runs the sync at once if the new time has
# come since the last run: deploy it before the new time first comes round
# after the last run.
OnCalendar=*-*-* 10:30:00 UTC
# A catch-up run after downtime could swap staging's database mid-workday.
Persistent=false

[Install]
WantedBy=timers.target
